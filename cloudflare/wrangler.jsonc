{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aksara-apps",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/.netlify/functions/*"],
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      { "name": "AKSARA_CONTROL", "class_name": "AksaraControl" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AksaraControl"] }
  ],
  "vars": {
    "AKSARA_HYBRID_ROUTER": "true",
    "AKSARA_SHARED_CHAT_BUDGET": "false",
    "AKSARA_FREE_FALLBACKS": "true",
    "STUDIO_DISABLED": "false",
    "AKSARA_CLOUD_MIGRATION": "preview"
  },
  "observability": {"enabled": true}
}

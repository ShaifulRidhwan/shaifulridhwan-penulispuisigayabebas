<resources>
    <style name="Theme.Aksara" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#e6c58b</item>
        <item name="android:windowBackground">#070911</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.Aksara.Launch" parent="Theme.Aksara">
        <item name="android:windowSplashScreenBackground">@color/aksara_launch_midnight</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/aksara_icon_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">450</item>
        <item name="android:windowBackground">@color/aksara_launch_midnight</item>
    </style>
</resources>

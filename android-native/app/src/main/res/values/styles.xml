<resources>
    <style name="Theme.Aksara" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#e6c58b</item>
        <item name="android:windowBackground">#070911</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <!-- Android 12+ system-owned starting window: prevents the default white flash. -->
    <style name="Theme.Aksara.Launch" parent="Theme.Aksara">
        <item name="android:windowSplashScreenBackground">#070911</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/aksara_splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#070911</item>
        <item name="android:windowBackground">#070911</item>
    </style>
</resources>

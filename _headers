# Alina v2 optimized GLB chunks. Immutable only while version path remains unchanged.
/ara-assets/v2/*
  Cache-Control: public, max-age=31536000, immutable

# Original chunks, retained for compatibility.
/ara-assets/part-*.bin
  Cache-Control: public, max-age=31536000, immutable

# Manifest must always reflect current release.
/ara-assets/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
